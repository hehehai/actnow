{
  "name": "actnow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "pnpm lint && pnpm format:check",
    "lint": "vp lint --react-plugin --jsx-a11y-plugin",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "dev:start": "pnpm --filter web run start",
    "check-types": "pnpm -r check-types",
    "db:generate": "pnpm --filter @actnow/db db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:migrate:local": "pnpm --filter web db:migrate:local",
    "db:migrate:remote": "pnpm --filter web db:migrate:remote",
    "db:migrate:production": "pnpm --filter web db:migrate:production",
    "db:seed": "pnpm --filter @actnow/db db:seed",
    "deploy": "pnpm --filter web run deploy",
    "cf-typegen": "pnpm --filter web cf-typegen",
    "deploy:destroy": "pnpm --filter web run destroy"
  },
  "dependencies": {
    "@actnow/common": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dotenv": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  }
}
