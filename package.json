{
  "name": "actnow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "biome check --write .",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "dev:start": "pnpm --filter web run start",
    "check-types": "pnpm -r check-types",
    "db:push": "pnpm --filter @actnow/db db:push",
    "db:studio": "pnpm --filter @actnow/db db:studio",
    "db:generate": "pnpm --filter @actnow/db db:generate",
    "db:migrate": "pnpm --filter @actnow/db db:migrate",
    "db:seed": "pnpm --filter @actnow/db db:seed",
    "deploy": "pnpm --filter web run deploy",
    "deploy:destroy": "pnpm --filter web run destroy"
  },
  "dependencies": {
    "@actnow/common": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260216.1",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "ultracite": "7.2.2"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  }
}
