{
  "name": "@actnow/auth",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "schema:gen": "dotenv -e ../../apps/web/.env -- npx @better-auth/cli@latest generate --config src/index.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  },
  "dependencies": {
    "@actnow/db": "workspace:*",
    "@actnow/email": "workspace:*",
    "@devmehq/email-validator-js": "^2.10.4",
    "@polar-sh/better-auth": "^1.8.1",
    "@polar-sh/sdk": "^0.43.1",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  }
}
