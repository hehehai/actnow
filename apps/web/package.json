{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:prepare": "pnpm run db:migrate:local",
    "build": "vite build",
    "dev": "CLOUDFLARE_ENV=development pnpm run dev:prepare && CLOUDFLARE_ENV=development vite dev --port=3002",
    "dev:clean": "rm -rf node_modules/.vite && pnpm run dev",
    "preview": "vite preview",
    "check-types": "tsgo --noEmit",
    "deploy": "vite build && wrangler deploy",
    "destroy": "wrangler delete",
    "cf-typegen": "wrangler types --env development",
    "db:migrate": "pnpm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env development",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@actnow/api": "workspace:*",
    "@actnow/auth": "workspace:*",
    "@actnow/common": "workspace:*",
    "@actnow/db": "workspace:*",
    "@base-ui/react": "^1.2.0",
    "@fontsource/google-sans-flex": "^5.2.2",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.5",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "^1.13.5",
    "@orpc/zod": "catalog:",
    "@polar-sh/better-auth": "^1.8.1",
    "@polar-sh/sdk": "^0.43.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.160.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.160.0",
    "@tanstack/zod-adapter": "^1.160.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "catalog:",
    "input-otp": "^1.4.2",
    "motion": "^12.34.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "recharts": "3.7.0",
    "shadcn": "^3.8.5",
    "slug": "^11.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "use-file-picker": "^2.1.4",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.7",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@devmehq/email-validator-js": "^2.10.4",
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/hugeicons": "^1.2.23",
