{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:prepare": "pnpm run db:migrate:local",
    "build": "vite build",
    "dev": "CLOUDFLARE_ENV=development pnpm run dev:prepare && CLOUDFLARE_ENV=development vite dev --port=3002",
    "dev:clean": "rm -rf node_modules/.vite && pnpm run dev",
    "preview": "vite preview",
    "check-types": "tsgo --noEmit",
    "deploy": "vite build && wrangler deploy",
    "destroy": "wrangler delete",
    "cf-typegen": "wrangler types --env development",
    "db:migrate": "pnpm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env development",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@actnow/api": "workspace:*",
    "@actnow/auth": "workspace:*",
    "@actnow/common": "workspace:*",
    "@actnow/db": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fontsource/google-sans-flex": "^5.3.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "^1.15.6",
    "@orpc/zod": "catalog:",
    "@polar-sh/better-auth": "^2.1.0",
    "@polar-sh/sdk": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.45",
    "@tanstack/zod-adapter": "^1.167.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "catalog:",
    "input-otp": "^1.5.0",
    "motion": "^14.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "3.10.1",
    "shadcn": "^4.21.4",
    "slug": "^12.0.1",
    "sonner": "^2.0.8",
