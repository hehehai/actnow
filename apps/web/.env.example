# Legacy fallback environment variables
# Prefer apps/web/.dev.vars for local Worker development.

# CORS & Auth URLs can be overridden here for non-Worker tooling if needed.
CORS_ORIGIN="http://localhost:3002"
BETTER_AUTH_URL="http://localhost:3002"

# Better Auth - generate with: pnpm dlx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=""

# Email (React Email + Resend)
EMAIL_USER="noreply@your-domain.com"
RESEND_API_KEY="re_xxx"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 Storage

# Public R2 storage URL (client-side accessible)
VITE_CLOUD_FLARE_R2_URL="https://storage.your-domain.com"

# Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ENVIRONMENT="sandbox"
POLAR_PRODUCT_PRO_MONTHLY_ID=""
POLAR_PRODUCT_PRO_YEARLY_ID=""
POLAR_PRODUCT_PRO_PLUS_MONTHLY_ID=""
POLAR_PRODUCT_PRO_PLUS_YEARLY_ID=""
